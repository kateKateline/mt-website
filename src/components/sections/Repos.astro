---
import RepoCard from "@/components/cards/RepoCard.astro";
import RepoSkeleton from "@/components/cards/RepoSkeleton.astro";
---

<section
  id="repos"
  class="relative bg-black py-24"
>
  <div class="max-w-7xl mx-auto px-6">
    <!-- TITLE -->
    <h3 class="text-3xl md:text-4xl font-semibold text-white mb-4">
      Top Project
    </h3>

    <p class="max-w-2xl text-white/60 mb-12">
      A selection of core repositories that power our products and internal tooling.
    </p>

    <!-- GRID -->
    <div
      class="
        grid
        grid-cols-1
        sm:grid-cols-2
        lg:grid-cols-3
        gap-6
      "
      id="repos-grid"
    >
      <!-- Skeleton loaders - will be replaced by actual data -->
      {Array.from({ length: 6 }).map((_, i) => (
        <RepoSkeleton client:load={false} />
      ))}
    </div>
  </div>
</section>

<script>
  // Load repos asynchronously after page load
  (async function() {
    // Wait for DOM to be ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadRepos);
    } else {
      loadRepos();
    }

    async function loadRepos() {
      const grid = document.getElementById('repos-grid');
      if (!grid) return;

      try {
        const response = await fetch('/api/repos.json');
        if (!response.ok) throw new Error('Failed to fetch repos');
        
        const repos = await response.json();
        
        if (repos.length === 0) {
          grid.innerHTML = '<p class="text-white/60 col-span-full text-center py-12">No projects found.</p>';
          return;
        }

        // Escape HTML to prevent XSS
        function escapeHtml(text) {
          const div = document.createElement('div');
          div.textContent = text;
          return div.innerHTML;
        }

        // Replace skeleton with actual repo cards
        grid.innerHTML = repos.map((repo) => {
          const techStack = (repo.languages?.nodes || []).map((lang) => lang.name) || 
                           (repo.primaryLanguage ? [repo.primaryLanguage.name] : []);
          const techTags = techStack.slice(0, 3).map((tech) => 
            `<span class="text-xs px-2 py-1 rounded-md border border-white/10 text-white/65">${escapeHtml(tech)}</span>`
          ).join('');

          return `
            <div class="w-full rounded-xl border border-white/10 bg-white/5 p-6 flex flex-col text-white transition-colors duration-300 hover:bg-white/8">
              <div class="flex items-start justify-between gap-4 min-w-0">
                <div class="min-w-0 flex-1">
                  <h4 class="text-sm font-semibold tracking-tight truncate">${escapeHtml(repo.name || 'Unknown')}</h4>
                  <p class="mt-1 text-sm text-white/60 leading-relaxed line-clamp-2">${escapeHtml(repo.description || 'No description available')}</p>
                </div>
                <span class="text-xs text-white/50 whitespace-nowrap shrink-0">★ ${repo.stargazerCount || 0}</span>
              </div>
              ${techTags ? `<div class="mt-4 flex flex-wrap gap-2">${techTags}</div>` : ''}
              <div class="mt-auto pt-5">
                <a href="${escapeHtml(repo.url || '#')}" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-white/70 hover:text-white transition">
                  View repository →
                </a>
              </div>
            </div>
          `;
        }).join('');
      } catch (error) {
        console.error('Error loading repos:', error);
        grid.innerHTML = '<p class="text-white/60 col-span-full text-center py-12">Failed to load projects. Please refresh the page.</p>';
      }
    }
  })();
</script>
