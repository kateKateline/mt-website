---
import MemberCard from "@/components/cards/MemberCard.astro";

const members = [
  { name: "Alice", role: "Frontend Developer", description: "Focuses on React and UI/UX.", github: "https://github.com/alice" },
  { name: "Bob", role: "Backend Developer", description: "Builds APIs and services.", github: "https://github.com/bob" },
  { name: "Charlie", role: "Fullstack Developer", description: "Works across frontend and backend.", github: "https://github.com/charlie" },
  { name: "Diana", role: "UI Designer", description: "Designs interfaces and prototyping.", github: "https://github.com/diana" },
  { name: "Evan", role: "DevOps Engineer", description: "CI/CD and infrastructure.", github: "https://github.com/evan" },
  { name: "Fiona", role: "Project Manager", description: "Coordinates roadmap and teams.", github: "https://github.com/fiona" },
];

// duplikasi supaya loop mulus
const loopMembers = [...members, ...members];
---

<section
  id="members"
  class="relative bg-black py-24"
>
  <!-- TITLE -->
  <div class="max-w-7xl mx-auto px-6">
    <h3 class="text-center text-3xl md:text-4xl font-semibold text-white mb-16">
      Team Members
    </h3>
  </div>

  <!-- MARQUEE WRAPPER (BATAS MERAH) -->
<div class="relative max-w-7xl mx-auto px-6 overflow-hidden">
  <!-- left fade -->
  <div class="pointer-events-none absolute left-0 top-0 h-full w-14 bg-linear-to-r from-black to-transparent z-10"></div>

  <!-- right fade -->
  <div class="pointer-events-none absolute right-0 top-0 h-full w-14 bg-linear-to-l from-black to-transparent z-10"></div>

  <div class="flex gap-8 w-max animate-member-scroll py-4">
      {loopMembers.map((member) => (
        <MemberCard
          name={member.name}
          role={member.role}
          description={member.description}
          github={member.github}
        />
      ))}
    </div>
  </div>
</section>

