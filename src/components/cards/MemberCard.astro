---
const { name, role, github = "#", avatar } = Astro.props;
const initials = (name || "")
  .split(" ")
  .map((n: string) => n[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<div class="w-75 min-w-75 max-w-75 h-full rounded-xl border border-white/10 bg-white/5 backdrop-blur-sm p-6 flex flex-col text-white transition-colors duration-300 hover:bg-white/8">
  <div class="flex items-center gap-4 min-w-0">
    {avatar ? (
      <img src={avatar} alt={`${name} avatar`} class="w-11 h-11 rounded-full object-cover shrink-0" />
    ) : (
      <div class="w-11 h-11 rounded-full bg-white text-black font-medium flex items-center justify-center shrink-0">
        {initials}
      </div>
    )}

    <div class="min-w-0 flex-1">
      <h4 class="text-sm font-semibold leading-tight truncate">{name}</h4>
      <p class="text-xs text-white/55 truncate">{role}</p>
    </div>
  </div>

  <div class="mt-auto pt-5">
    <a href={github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-sm font-medium text-white/70 hover:text-white transition">
      View GitHub →
    </a>
  </div>
</div>