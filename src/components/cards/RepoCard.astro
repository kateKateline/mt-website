---
const { name, description, tech = [], stars = 0 } = Astro.props;
---

<div
  class="
    rounded-xl
    border border-white/10
    bg-white/5
    p-6
    flex flex-col
    text-white
    transition-colors duration-300
    hover:bg-white/8
  "
>
  <!-- HEADER -->
  <div class="flex items-start justify-between gap-4">
    <div>
      <h4 class="text-sm font-semibold tracking-tight">
        {name}
      </h4>
      <p class="mt-1 text-sm text-white/60 leading-relaxed">
        {description}
      </p>
    </div>

    <span class="text-xs text-white/50 whitespace-nowrap">
      ★ {stars}
    </span>
  </div>

  <!-- TECH STACK -->
  {tech.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {tech.map((t: string) => (
        <span
          class="
            text-xs
            px-2 py-1
            rounded-md
            border border-white/10
            text-white/65
          "
        >
          {t}
        </span>
      ))}
    </div>
  )}

  <!-- FOOTER -->
  <div class="mt-auto pt-5">
    <a
      href="#"
      class="
        text-sm
        font-medium
        text-white/70
        hover:text-white
        transition
      "
    >
      View repository →
    </a>
  </div>
</div>
