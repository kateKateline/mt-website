---
---
<div
  class="
    w-full
    rounded-xl
    border border-white/10
    bg-white/5
    p-6
    flex flex-col
    text-white
  "
>
  <!-- HEADER -->
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <div class="h-4 bg-white/10 rounded w-3/4 mb-2 animate-pulse"></div>
      <div class="h-3 bg-white/10 rounded w-full mb-1 animate-pulse" style="animation-delay: 0.1s"></div>
      <div class="h-3 bg-white/10 rounded w-5/6 animate-pulse" style="animation-delay: 0.2s"></div>
    </div>
    <div class="h-4 bg-white/10 rounded w-12 shrink-0 animate-pulse"></div>
  </div>

  <!-- TECH STACK -->
  <div class="mt-4 flex flex-wrap gap-2">
    <div class="h-6 bg-white/10 rounded-md w-16 animate-pulse" style="animation-delay: 0.3s"></div>
    <div class="h-6 bg-white/10 rounded-md w-20 animate-pulse" style="animation-delay: 0.4s"></div>
    <div class="h-6 bg-white/10 rounded-md w-14 animate-pulse" style="animation-delay: 0.5s"></div>
  </div>

  <!-- FOOTER -->
  <div class="mt-auto pt-5">
    <div class="h-4 bg-white/10 rounded w-32 animate-pulse" style="animation-delay: 0.6s"></div>
  </div>
</div>

